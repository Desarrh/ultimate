{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ultimate",
  "version": "0.3.0",
  "identifier": "dev.local.launcher",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ultimate",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 620,
        "backgroundColor": "#0A0A0C"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "shortDescription": "Ultimate : toute ta bibliothèque de jeux au même endroit",
    "publisher": "Desarrh",
    "copyright": "© 2026 Desarrh · GPL-3.0-or-later",
    "homepage": "https://github.com/Desarrh/ultimate",
    "category": "Game",
    "licenseFile": "../LICENSE"
  },
  "mainBinaryName": "Ultimate",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDAxNkVCMkI0QTNFNzNEOTgKUldTWVBlZWp0TEp1QVVuNk53SmlOK0FOWlI0RS9wQlBsc0tTclpnbHpGSUtuOEFFK2tSUXhjb0YK",
      "endpoints": [],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
